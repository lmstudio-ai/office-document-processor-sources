+sal_uInt64 gCoreTextFontGeneration = 0;
+
+// CoreText family and style names use the same UTF-16 representation as OUString.
+OUString GetOUStringFromCoreText(CFStringRef pString)
+{
+    if (pString == nullptr)
+        return OUString();
+
+    CFIndex nLength = CFStringGetLength(pString);
+    if (nLength == 0)
+        return OUString();
+
+    const UniChar* pCharacters = CFStringGetCharactersPtr(pString);
+    if (pCharacters != nullptr)
+        return OUString(reinterpret_cast<const sal_Unicode*>(pCharacters), nLength);
+
+    std::unique_ptr<UniChar[]> pBuffer(new UniChar[nLength]);
+    CFStringGetCharacters(pString, CFRangeMake(0, nLength), pBuffer.get());
+    return OUString(reinterpret_cast<const sal_Unicode*>(pBuffer.get()), nLength);
+}
+}
+
+// CoreText only sees LibreOffice's private fonts after they have been registered for this process.
+bool RegisterCoreTextFont(const OUString& rFontFileURL)
+{
+    OUString aSystemPath;
+    if (osl::FileBase::getSystemPathFromFileURL(rFontFileURL, aSystemPath)
+        != osl::FileBase::E_None)
+    {
+        return false;
+    }
+
+    OString aFileName = OUStringToOString(aSystemPath, RTL_TEXTENCODING_UTF8);
+    CFStringRef pFontPath = CFStringCreateWithCString(
+        nullptr, aFileName.getStr(), kCFStringEncodingUTF8);
+    if (!pFontPath)
+        return false;
+
+    CFURLRef pFontURL = CFURLCreateWithFileSystemPath(
+        nullptr, pFontPath, kCFURLPOSIXPathStyle, true);
+    CFRelease(pFontPath);
+    if (!pFontURL)
+        return false;
+
+    CFErrorRef pError = nullptr;
+    bool bSuccess
+        = CTFontManagerRegisterFontsForURL(pFontURL, kCTFontManagerScopeProcess, &pError);
+    if (pError)
+        CFRelease(pError);
+    CFRelease(pFontURL);
+    if (bSuccess)
+        ++gCoreTextFontGeneration;
+    return bSuccess;
+}
+
+// Unregistering through the same helper keeps Aqua's temporary-font lifecycle unchanged.
+bool UnregisterCoreTextFont(const OUString& rFontFileURL)
+{
+    OUString aSystemPath;
+    if (osl::FileBase::getSystemPathFromFileURL(rFontFileURL, aSystemPath)
+        != osl::FileBase::E_None)
+    {
+        return false;
+    }
+
+    OString aFileName = OUStringToOString(aSystemPath, RTL_TEXTENCODING_UTF8);
+    CFStringRef pFontPath = CFStringCreateWithCString(
+        nullptr, aFileName.getStr(), kCFStringEncodingUTF8);
+    if (!pFontPath)
+        return false;
+
+    CFURLRef pFontURL = CFURLCreateWithFileSystemPath(
+        nullptr, pFontPath, kCFURLPOSIXPathStyle, true);
+    CFRelease(pFontPath);
+    if (!pFontURL)
+        return false;
+
+    bool bSuccess = CTFontManagerUnregisterFontsForURL(
+        pFontURL, kCTFontManagerScopeProcess, nullptr);
+    CFRelease(pFontURL);
+    if (bSuccess)
+        ++gCoreTextFontGeneration;
+    return bSuccess;
+}
+
+static void RegisterCoreTextFontDir(const OUString& rFontDirURL)
+{
+    osl::Directory aFontDir(rFontDirURL);
+    if (aFontDir.open() != osl::FileBase::E_None)
+        return;
+
+    osl::DirectoryItem aDirItem;
+    while (aFontDir.getNextItem(aDirItem, 10) == osl::FileBase::E_None)
+    {
+        osl::FileStatus aFileStatus(osl_FileStatus_Mask_FileURL);
+        if (aDirItem.getFileStatus(aFileStatus) == osl::FileBase::E_None)
+            RegisterCoreTextFont(aFileStatus.getFileURL());
+    }
+}
+
+// Register the bundled fallback fonts before either backend snapshots CoreText's inventory.
+void RegisterCoreTextPrivateFonts()
+{
+    static bool bFirst = true;
+    if (!bFirst)
+        return;
+    bFirst = false;
+
+    OUString aBrandPath("$BRAND_BASE_DIR");
+    rtl_bootstrap_expandMacros(&aBrandPath.pData);
+    RegisterCoreTextFontDir(
+        aBrandPath + "/" LIBO_SHARE_RESOURCE_FOLDER "/common/fonts/");
+    RegisterCoreTextFontDir(aBrandPath + "/" LIBO_SHARE_FOLDER "/fonts/truetype/");
+}
+
+// SVP uses this to rebuild its snapshot only after CoreText registrations change.
+sal_uInt64 GetCoreTextFontGeneration()
+{
+    return gCoreTextFontGeneration;
+}
+
+// Compare file identity so a Fontconfig symlink can still match CoreText's resolved path.
+static bool CoreTextFontDescriptorMatchesFile(CTFontDescriptorRef descriptor,
+                                              CFStringRef requestedFile)
+{
+    if (descriptor == nullptr || requestedFile == nullptr)
+        return false;
+
+    CFURLRef descriptorURL = static_cast<CFURLRef>(
+        CTFontDescriptorCopyAttribute(descriptor, kCTFontURLAttribute));
+    if (descriptorURL == nullptr)
+        return false;
+
+    CFStringRef descriptorFile
+        = CFURLCopyFileSystemPath(descriptorURL, kCFURLPOSIXPathStyle);
+    CFRelease(descriptorURL);
+    if (descriptorFile == nullptr)
+        return false;
+
+    bool matches = CFEqual(descriptorFile, requestedFile);
+    if (!matches)
+    {
+        char descriptorPath[PATH_MAX];
+        char requestedPath[PATH_MAX];
+        struct stat descriptorStatus;
+        struct stat requestedStatus;
+        matches = CFStringGetCString(
+                      descriptorFile, descriptorPath, sizeof(descriptorPath), kCFStringEncodingUTF8)
+                  && CFStringGetCString(
+                      requestedFile, requestedPath, sizeof(requestedPath), kCFStringEncodingUTF8)
+                  && stat(descriptorPath, &descriptorStatus) == 0
+                  && stat(requestedPath, &requestedStatus) == 0
+                  && descriptorStatus.st_dev == requestedStatus.st_dev
+                  && descriptorStatus.st_ino == requestedStatus.st_ino;
+    }
+    CFRelease(descriptorFile);
+    return matches;
+}
+
+// Find the CoreText descriptor selected for a Fontconfig face without crossing duplicate files.
+CTFontDescriptorRef FindCoreTextFontDescriptor(CFDictionaryRef fonts, CFStringRef requestedName,
+                                               CFStringRef requestedFile,
+                                               CFStringRef requestedFamily,
+                                               CFStringRef requestedStyle)
+{
+    if (fonts == nullptr || requestedName == nullptr || requestedFile == nullptr
+        || requestedFamily == nullptr || requestedStyle == nullptr)
+    {
+        return nullptr;
+    }
+
+    CTFontDescriptorRef descriptor = static_cast<CTFontDescriptorRef>(
+        CFDictionaryGetValue(fonts, requestedName));
+    if (CoreTextFontDescriptorMatchesFile(descriptor, requestedFile))
+        return descriptor;
+
+    const void* keyValues[] = { requestedFile, requestedFamily, requestedStyle };
+    CFArrayRef key = CFArrayCreate(nullptr, keyValues, 3, &kCFTypeArrayCallBacks);
+    descriptor = static_cast<CTFontDescriptorRef>(CFDictionaryGetValue(fonts, key));
+    CFRelease(key);
+    if (descriptor != nullptr)
+        return descriptor;
+
+    const CFIndex count = CFDictionaryGetCount(fonts);
+    if (count == 0)
+        return nullptr;
+    std::vector<const void*> descriptors(count);
+    CFDictionaryGetKeysAndValues(fonts, nullptr, descriptors.data());
+    for (const void* value : descriptors)
+    {
+        descriptor = static_cast<CTFontDescriptorRef>(value);
+        CFStringRef family = static_cast<CFStringRef>(
+            CTFontDescriptorCopyAttribute(descriptor, kCTFontFamilyNameAttribute));
+        CFStringRef style = static_cast<CFStringRef>(
+            CTFontDescriptorCopyAttribute(descriptor, kCTFontStyleNameAttribute));
+        const bool matches = family != nullptr && style != nullptr
+                             && CFEqual(family, requestedFamily) && CFEqual(style, requestedStyle)
+                             && CoreTextFontDescriptorMatchesFile(descriptor, requestedFile);
+        if (style != nullptr)
+            CFRelease(style);
+        if (family != nullptr)
+            CFRelease(family);
+        if (matches)
+            return descriptor;
+    }
+    return nullptr;
+}
+
+FontAttributes DevFontFromCTFontDescriptor( CTFontDescriptorRef pFD, bool* bFontEnabled )
+{
+    // all CoreText fonts are device fonts that can rotate just fine
+    FontAttributes rDFA;
+    rDFA.SetQuality( 0 );
+
+    // reset the font attributes
+    rDFA.SetFamilyType( FAMILY_DONTKNOW );
+    rDFA.SetPitch( PITCH_VARIABLE );
+    rDFA.SetWidthType( WIDTH_NORMAL );
+    rDFA.SetWeight( WEIGHT_NORMAL );
+    rDFA.SetItalic( ITALIC_NONE );
+    rDFA.SetMicrosoftSymbolEncoded( false );
+
+    // get font name
+    CFStringRef pLang = nullptr;
+    CFStringRef pFamilyName = static_cast<CFStringRef>(
+            CTFontDescriptorCopyLocalizedAttribute( pFD, kCTFontFamilyNameAttribute, &pLang ));
+
+    if ( !pLang )
+    {
+        if( pFamilyName )
+        {
+            CFRelease( pFamilyName );
+        }
+        pFamilyName = static_cast<CFStringRef>(CTFontDescriptorCopyAttribute( pFD, kCTFontFamilyNameAttribute ));
+    }
+
+    rDFA.SetFamilyName( GetOUStringFromCoreText( pFamilyName ) );
+    if (pLang)
+        CFRelease(pLang);
+    if (pFamilyName)
+        CFRelease(pFamilyName);
+
+    // get font style
+    CFStringRef pStyleName = static_cast<CFStringRef>(CTFontDescriptorCopyAttribute( pFD, kCTFontStyleNameAttribute ));
+    rDFA.SetStyleName( GetOUStringFromCoreText( pStyleName ) );
+    if (pStyleName)
+        CFRelease(pStyleName);
+
+    // get font-enabled status
+    if( bFontEnabled )
+    {
+        int bEnabled = TRUE; // by default (and when we're on macOS < 10.6) it's "enabled"
+        CFNumberRef pEnabled = static_cast<CFNumberRef>(CTFontDescriptorCopyAttribute( pFD, kCTFontEnabledAttribute ));
+        if (pEnabled)
+        {
+            CFNumberGetValue( pEnabled, kCFNumberIntType, &bEnabled );
+            CFRelease(pEnabled);
+        }
+        *bFontEnabled = bEnabled;
+    }
+
+    // get font attributes
+    CFDictionaryRef pAttrDict = static_cast<CFDictionaryRef>(CTFontDescriptorCopyAttribute( pFD, kCTFontTraitsAttribute ));
+
+    if (bFontEnabled && *bFontEnabled)
+    {
+        // Ignore font formats not supported.
+        int nFormat;
+        CFNumberRef pFormat = static_cast<CFNumberRef>(CTFontDescriptorCopyAttribute(pFD, kCTFontFormatAttribute));
+        CFNumberGetValue(pFormat, kCFNumberIntType, &nFormat);
+        if (nFormat == kCTFontFormatUnrecognized || nFormat == kCTFontFormatPostScript || nFormat == kCTFontFormatBitmap)
+        {
+            SAL_INFO("vcl.fonts", "Ignoring font with unsupported format: " << rDFA.GetFamilyName());
+            *bFontEnabled = false;
+        }
+        CFRelease(pFormat);
+    }
+
+    // get symbolic trait
+    // TODO: use other traits such as MonoSpace/Condensed/Expanded or Vertical too
+    SInt64 nSymbolTrait = 0;
+    CFNumberRef pSymbolNum = nullptr;
+    if( CFDictionaryGetValueIfPresent( pAttrDict, kCTFontSymbolicTrait, reinterpret_cast<const void**>(&pSymbolNum) ) )
+    {
+        CFNumberGetValue( pSymbolNum, kCFNumberSInt64Type, &nSymbolTrait );
+        if (nSymbolTrait & kCTFontMonoSpaceTrait)
+            rDFA.SetPitch(PITCH_FIXED);
+    }
+
+    // get the font weight
+    double fWeight = 0;
+    CFNumberRef pWeightNum = static_cast<CFNumberRef>(CFDictionaryGetValue( pAttrDict, kCTFontWeightTrait ));
+    // tdf#140401 check if attribute is a nullptr
+    if( pWeightNum )
+        CFNumberGetValue( pWeightNum, kCFNumberDoubleType, &fWeight );
+    int nInt = WEIGHT_NORMAL;
+
+    // Special case fixes
+
+    // tdf#67744: Courier Std Medium is always bold. We get a kCTFontWeightTrait of 0.23 which
+    // surely must be wrong.
+    if (rDFA.GetFamilyName() == "Courier Std" &&
+        (rDFA.GetStyleName() == "Medium" || rDFA.GetStyleName() == "Medium Oblique") &&
+        fWeight > 0.2)
+    {
+        fWeight = 0;
+    }
+
+    // tdf#68889: Ditto for Gill Sans MT Pro. Here I can kinda understand it, maybe the
+    // kCTFontWeightTrait is intended to give a subjective "optical" impression of how the font
+    // looks, and Gill Sans MT Pro Medium is kinda heavy. But with the way LibreOffice uses fonts,
+    // we still should think of it as being "medium" weight.
+    if (rDFA.GetFamilyName() == "Gill Sans MT Pro" &&
+        (rDFA.GetStyleName() == "Medium" || rDFA.GetStyleName() == "Medium Italic") &&
+        fWeight > 0.2)
+    {
+        fWeight = 0;
+    }
+
+    if( fWeight > 0 )
+    {
+        nInt = rint(int(WEIGHT_NORMAL) + fWeight * ((WEIGHT_BLACK - WEIGHT_NORMAL)/0.68));
+        if( nInt > WEIGHT_BLACK )
+        {
+            nInt = WEIGHT_BLACK;
+        }
+    }
+    else if( fWeight < 0 )
+    {
+        nInt = rint(int(WEIGHT_NORMAL) + fWeight * ((WEIGHT_NORMAL - WEIGHT_THIN)/0.8));
+        if( nInt < WEIGHT_THIN )
+        {
+            nInt = WEIGHT_THIN;
+        }
+    }
+    rDFA.SetWeight( static_cast<FontWeight>(nInt) );
+
+    // get the font slant
+    double fSlant = 0;
+    CFNumberRef pSlantNum = static_cast<CFNumberRef>(CFDictionaryGetValue( pAttrDict, kCTFontSlantTrait ));
+    // tdf#140401 check if attribute is a nullptr
+    if( pSlantNum )
+        CFNumberGetValue( pSlantNum, kCFNumberDoubleType, &fSlant );
+    if( fSlant >= 0.035 )
+    {
+        rDFA.SetItalic( ITALIC_NORMAL );
+    }
+    // get width trait
+    double fWidth = 0;
+    CFNumberRef pWidthNum = static_cast<CFNumberRef>(CFDictionaryGetValue( pAttrDict, kCTFontWidthTrait ));
+    // tdf#140401 check if attribute is a nullptr
+    if( pWidthNum )
+        CFNumberGetValue( pWidthNum, kCFNumberDoubleType, &fWidth );
+    nInt = WIDTH_NORMAL;
+
+    if( fWidth > 0 )
+    {
+        nInt = rint( int(WIDTH_NORMAL) + fWidth * ((WIDTH_ULTRA_EXPANDED - WIDTH_NORMAL)/0.4));
+        if( nInt > WIDTH_ULTRA_EXPANDED )
+        {
+            nInt = WIDTH_ULTRA_EXPANDED;
+        }
+    }
+    else if( fWidth < 0 )
+    {
+        nInt = rint( int(WIDTH_NORMAL) + fWidth * ((WIDTH_NORMAL - WIDTH_ULTRA_CONDENSED)/0.5));
+        if( nInt < WIDTH_ULTRA_CONDENSED )
+        {
+            nInt = WIDTH_ULTRA_CONDENSED;
+        }
+    }
+    rDFA.SetWidthType( static_cast<FontWidth>(nInt) );
+
+    // release the attribute dict that we had copied
+    CFRelease( pAttrDict );
+
+    // TODO? also use the HEAD table if available to get more attributes
+//  CFDataRef CTFontCopyTable( CTFontRef, kCTFontTableHead, /*kCTFontTableOptionNoOptions*/kCTFontTableOptionExcludeSynthetic );
+
+    return rDFA;
+}
