+void VclFontTest::testCoreTextFontDescriptorLookup()
+{
+    // CoreText may resolve a path while Fontconfig keeps the symlink it scanned.
+    char selectedFilePath[] = "/tmp/vcl-font-test-XXXXXX";
+    const int fileDescriptor = mkstemp(selectedFilePath);
+    CPPUNIT_ASSERT(fileDescriptor >= 0);
+    CPPUNIT_ASSERT_EQUAL(0, close(fileDescriptor));
+    char duplicateFilePath[] = "/tmp/vcl-font-test-XXXXXX";
+    const int duplicateFileDescriptor = mkstemp(duplicateFilePath);
+    CPPUNIT_ASSERT(duplicateFileDescriptor >= 0);
+    CPPUNIT_ASSERT_EQUAL(0, close(duplicateFileDescriptor));
+    const std::string symlinkPath = std::string(selectedFilePath) + ".link";
+    CPPUNIT_ASSERT_EQUAL(0, symlink(selectedFilePath, symlinkPath.c_str()));
+
+    CFStringRef selectedFile = CFStringCreateWithCString(
+        nullptr, selectedFilePath, kCFStringEncodingUTF8);
+    CFStringRef symlinkFile = CFStringCreateWithCString(
+        nullptr, symlinkPath.c_str(), kCFStringEncodingUTF8);
+    CFStringRef duplicateFile = CFStringCreateWithCString(
+        nullptr, duplicateFilePath, kCFStringEncodingUTF8);
+    CFURLRef selectedURL = CFURLCreateWithFileSystemPath(
+        nullptr, selectedFile, kCFURLPOSIXPathStyle, false);
+    CPPUNIT_ASSERT(selectedURL != nullptr);
+
+    const void* attributeKeys[] = {
+        kCTFontURLAttribute, kCTFontFamilyNameAttribute, kCTFontStyleNameAttribute
+    };
+    const void* attributeValues[] = {
+        selectedURL, CFSTR("Selected Family"), CFSTR("Regular")
+    };
+    CFDictionaryRef attributes = CFDictionaryCreate(
+        nullptr, attributeKeys, attributeValues, 3, &kCFTypeDictionaryKeyCallBacks,
+        &kCFTypeDictionaryValueCallBacks);
+    CTFontDescriptorRef descriptor = CTFontDescriptorCreateWithAttributes(attributes);
+    CPPUNIT_ASSERT(descriptor != nullptr);
+    CFMutableDictionaryRef fonts = CFDictionaryCreateMutable(
+        nullptr, 1, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(fonts, CFSTR("Selected-Regular"), descriptor);
+
+    CPPUNIT_ASSERT(FindCoreTextFontDescriptor(
+        fonts, CFSTR("Selected-Regular"), selectedFile,
+        CFSTR("Selected Family"), CFSTR("Regular")) == descriptor);
+    CPPUNIT_ASSERT(FindCoreTextFontDescriptor(
+        fonts, CFSTR("Selected-Regular"), symlinkFile,
+        CFSTR("Selected Family"), CFSTR("Regular")) == descriptor);
