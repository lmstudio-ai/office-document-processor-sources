--- a/vcl/source/graphic/Manager.cxx
+++ b/vcl/source/graphic/Manager.cxx
@@ -196,5 +196,10 @@

     for (MemoryManaged* pMemoryManaged : aObjectListCopy)
     {
+        // The object may have been unregistered and destroyed while the mutex was
+        // unlocked by a previous reduceMemory() call below.
+        if (maObjectList.find(pMemoryManaged) == maObjectList.end())
+            continue;
+
         if (!pMemoryManaged->canReduceMemory())
             continue;
