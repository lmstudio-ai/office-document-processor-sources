@@ -29,4 +29,6 @@
-
+# Turning off media playback clears AVMEDIA, but Impress slideshow code still calls shared
+# functions from the avmedia library. Treating it as optional causes unresolved symbols when
+# linking, so keep the core library linked even though media playback is disabled.
 $(eval $(call gb_Library_use_libraries,slideshow,\
-    $(call gb_Helper_optional,AVMEDIA,avmedia) \
+    avmedia \
     basegfx \
