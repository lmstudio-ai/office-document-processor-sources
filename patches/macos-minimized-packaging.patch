--- a/postprocess/Module_postprocess.mk
+++ b/postprocess/Module_postprocess.mk
@@ -40,7 +40,10 @@
 # contain content from at least one of external/more_fonts/fc_local.snippet
 # (conditional on MORE_FONTS in BUILD_TYPE) and
 # extras/source/truetype/symbol/fc_local.snippet (unconditional):
-ifneq ($(USING_X11)$(DISABLE_GUI)$(filter ANDROID EMSCRIPTEN,$(OS)),)
+# "SVP" is LibreOffice's non-windowed renderer. It relies on Fontconfig to find fonts and choose
+# replacements when a document requests a font that is not installed. macOS sets neither USING_X11
+# nor DISABLE_GUI, so upstream skips this setup and background previews use the wrong fonts.
+ifneq ($(USING_X11)$(DISABLE_GUI)$(filter FONTCONFIG,$(BUILD_TYPE))$(filter ANDROID EMSCRIPTEN,$(OS)),)
 $(eval $(call gb_Module_add_targets,postprocess, \
     CustomTarget_fontconfig \
     Package_fontconfig \
--- a/external/libeot/ExternalProject_libeot.mk
+++ b/external/libeot/ExternalProject_libeot.mk
@@ -15,0 +16,3 @@
+# Apple Silicon Clang miscompiles libeot's old MTX glyph decoder at -O2 and -Os,
+# corrupting embedded PowerPoint fonts. Limit only this external project to -O1;
+# the rest of LibreOffice retains the release build's normal optimization level.
@@ -21 +24 @@
-		&& $(gb_RUN_CONFIGURE) ./configure \
+		&& CFLAGS="$(CFLAGS) $(if $(filter MACOSX,$(OS)),-O1)" $(gb_RUN_CONFIGURE) ./configure \
--- a/scp2/source/ooo/file_ooo.scp
+++ b/scp2/source/ooo/file_ooo.scp
@@ -123,3 +123,7 @@
 // user interface configuration files
+// Disabling scripting means LibreOffice never creates BasicIDE.filelist. The upstream packaging
+// step still requests the missing file, aborting the archive build unless this entry is gated.
+#ifndef DISABLE_SCRIPTING
 UI_FILELIST(basicide, "UIConfig/modules/BasicIDE.filelist")
+#endif
 UI_FILELIST(cui, "UIConfig/cui.filelist")
--- a/slideshow/Library_slideshow.mk
